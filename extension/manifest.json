{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.4.0",
  "default_locale": "en",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://jobfinder-hazel-pi.vercel.app/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
