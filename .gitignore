# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Env / secrets
# .env.* covers .env.local / .env.production; the negation MUST stay last —
# git takes the last matching pattern, so a later `.env*` re-ignores the
# example file and makes a new one un-addable without `git add -f`.
.env
.env.*
*.env
!.env.example

# Database
*.db
*.sqlite3

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Output artifacts
backend/output/
*.docx.tmp

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local Claude Code config / personal skills (not part of the app)
.claude/
.agents/

.vercel

# Competitor UI reference captures (local only — screenshots of a third-party
# product plus the user's own resume data; never push these to GitHub).
reference-screenshots/

# Real-key A/B fixtures and results (backend/tests/ab_tailor.py) — the owner’s
# own resume plus real job ads and every measured run. Local only, like
# reference-screenshots/. The harness itself IS tracked; its data never is.
backend/tests/fixtures/ab/

# Inbox classifier A/B run outputs (backend/tests/inbox_eval.py --out). The
# fixtures themselves are synthetic and tracked; the measured runs are not.
backend/tests/fixtures/inbox_eval/results/

# Ghost-posting precision runs (backend/tests/ghost_eval.py, PLAN 28.5): every
# real run's corpus (posting text), its labelling worksheet, the spend ledger and
# a scratch SQLite. Local only, beside ab/. The harness also writes a `*`
# .gitignore into the folder itself, for checkouts that predate this line.
backend/tests/fixtures/ghost_eval/

# Chrome Web Store build output (extension/pack_store.py) and the listing's
# screenshots and promo tile. Rebuilt from the tracked extension/ at will.
extension-dist/
