# OpenAI configuration
OPENAI_API_KEY=sk-your-key-here
# OpenAI model id. gpt-4o-mini is cheap + fast and handles this JSON/rewrite
# work well. Step up to gpt-4.1-mini or gpt-4o for higher-stakes tailoring.
MODEL_ID=gpt-4o-mini

# Set to true to run the full pipeline offline with canned LLM responses
# (no API key needed). Useful for testing parsing/rendering/scoring/tracker.
USE_STUB_LLM=false

# Jooble job-search API key (free: https://jooble.org/api/about). DORMANT:
# the Jooble board is retired from the search fan-out — Jooble discontinued
# its Israeli index (verified 2026-07-05). Only needed if the provider is
# ever re-registered in app/core/providers/__init__.py.
JOOBLE_API_KEY=

# Job alerts: SMTP for the daily "new jobs" email (leave empty to disable the
# email step — alert runs still refresh history). Gmail: smtp.gmail.com:587
# with an app password (Google Account → Security → 2-Step → App passwords).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=

# Public app URL (no trailing slash) — used for the "Manage alerts" link in
# alert emails. Leave empty to omit the link.
APP_BASE_URL=

# Vercel cron auth: when set, GET /jobs/alerts/cron requires
# "Authorization: Bearer <CRON_SECRET>" — Vercel sends it automatically when
# a CRON_SECRET env var exists on the project.
CRON_SECRET=

# Friends beta (PLAN 7)
# Error tracking: a Sentry DSN enables the backend SDK (PII off, request
# bodies never sent). Leave empty to disable.
SENTRY_DSN=
# Environment tag on Sentry events. Set to "production" on Vercel; the default
# keeps local runs out of the prod error stream.
SENTRY_ENVIRONMENT=development
# Per-user daily cost caps (admins exempt; <= 0 disables a cap). These guard
# the OpenAI key while friends test.
DAILY_SEARCH_CAP=20
DAILY_TAILOR_CAP=30
# Everything else that calls the model — cover letter, the six interview
# routes, outreach, company brief, résumé health, the tools (PLAN 20.6/S2).
# These were free until Phase 20, which made the two caps above decorative:
# /interview/chat is a user-driven loop, one call per turn.
DAILY_LLM_CAP=150
# Auto-submit (PLAN 8.4): real applications sent per user per day (Comeet
# channel only; approved guard-clean kits only).
DAILY_SUBMIT_CAP=10
# Upload limits (PLAN 20.6/S3). /public/scan takes no access code, so an
# unbounded read is a free way to exhaust an instance. A master CV renders to
# ~30 pages at the extreme, hence the generous page ceiling.
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50
# The DOCX twin of MAX_PDF_PAGES: MAX_UPLOAD_MB caps COMPRESSED bytes, and a
# .docx is a zip — measured 343:1, so 0.298 MB of upload is 102 MB of XML that
# python-docx expands in full. A real 30-page master expands to 1.0 MB and an
# image-heavy CV at the upload cap to 10.3 MB, so 32 is ~3x the worst real
# document. The code raises this to 3 * MAX_UPLOAD_MB if you set it lower, so
# it can never refuse a CV the upload cap admits. <= 0 disables it.
MAX_DOCX_UNCOMPRESSED_MB=32

# CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database url
DATABASE_URL=sqlite:///./jobfinder.db
