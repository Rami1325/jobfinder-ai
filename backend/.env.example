# OpenAI configuration
OPENAI_API_KEY=sk-your-key-here
# OpenAI model id. gpt-4o-mini is cheap + fast and handles this JSON/rewrite
# work well. Step up to gpt-4.1-mini or gpt-4o for higher-stakes tailoring.
MODEL_ID=gpt-4o-mini

# Set to true to run the full pipeline offline with canned LLM responses
# (no API key needed). Useful for testing parsing/rendering/scoring/tracker.
USE_STUB_LLM=false

# Jooble job-search API key (free: https://jooble.org/api/about). DORMANT:
# the Jooble board is retired from the search fan-out — Jooble discontinued
# its Israeli index (verified 2026-07-05). Only needed if the provider is
# ever re-registered in app/core/providers/__init__.py.
JOOBLE_API_KEY=

# Job alerts: SMTP for the daily "new jobs" email (leave empty to disable the
# email step — alert runs still refresh history). Gmail: smtp.gmail.com:587
# with an app password (Google Account → Security → 2-Step → App passwords).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=

# Public app URL (no trailing slash) — used for the "Manage alerts" link in
# alert emails. Leave empty to omit the link.
APP_BASE_URL=

# The access-code gate and the admin credential. EMPTY = the gate is OFF: a
# request carrying neither X-App-Key nor a jf_session cookie resolves as the
# auto-created admin (app/api/deps.py), who is exempt from the monthly uses and
# the daily caps. That is the intended local mode; a deployment sets this in the
# Vercel dashboard, not in this file. The Chrome extension and "Have an invite
# code?" send it as X-App-Key, and it is the admin's own invite code.
APP_ACCESS_CODE=

# Vercel cron auth: when set, the crons require "Authorization: Bearer
# <CRON_SECRET>" — Vercel sends it automatically when a CRON_SECRET env var
# exists on the project. Required whenever APP_ACCESS_CODE is set: without it
# the alerts cron and the inbox cron refuse with 503 cron_unconfigured.
CRON_SECRET=

# Friends beta (PLAN 7)
# Error tracking: a Sentry DSN enables the backend SDK (PII off, request
# bodies never sent). Leave empty to disable.
SENTRY_DSN=
# Environment tag on Sentry events. Set to "production" on Vercel; the default
# keeps local runs out of the prod error stream.
SENTRY_ENVIRONMENT=development
# Per-user daily cost caps (admins exempt; <= 0 disables a cap). These guard
# the OpenAI key while friends test.
DAILY_SEARCH_CAP=20
DAILY_TAILOR_CAP=30
# Everything else that calls the model — cover letter, the six interview
# routes, outreach, company brief, resume health, the tools (PLAN 20.6/S2).
# These were free until Phase 20, which made the two caps above decorative:
# /interview/chat is a user-driven loop, one call per turn.
DAILY_LLM_CAP=150
# Auto-submit (PLAN 8.4): real applications sent per user per day (Comeet
# channel only; approved guard-clean kits only).
DAILY_SUBMIT_CAP=10
# Monthly uses (Phase 30, app/core/quota.py): ONE shared pool of this many uses a
# month per person, spent by every AI feature and given back when a call fails.
# The pool is keyed by a one-way hash of the sign-in address, so closing the
# account or deleting the data does not reset it. The admin and plan "unlimited"
# are exempt from THIS but not from the daily caps below. 0 (or less) switches the
# monthly limit off. Changing the number means hand-editing two copy keys in each
# locale — landing.hero.access and landing.faq.a3 in
# frontend/src/locales/{en,he}/marketing.json — because every other surface reads
# the server's value.
FREE_MONTHLY_USES=10
# Daily caps Phase 30 added, so one monthly use cannot buy unlimited requests.
# The first three are sub-steps of a counted flow (a tailor, a search) and cost no
# monthly use, because counting them would make one tailor cost two; the scan is
# counted here BEFORE its monthly use is reserved, so a daily refusal never spends
# one. Admins are exempt, plan "unlimited" is NOT, and 0 (or less) disables one.
DAILY_UPLOAD_CAP=10
DAILY_JD_ANALYZE_CAP=30
DAILY_SEARCH_CONTEXT_CAP=10
DAILY_SCAN_CAP=20
# /jobs/fetch reaches no model, so it is off the monthly pool and has no tokens to
# meter. What it spends is one outbound GET per call from the deployment's own IPs
# — invocations, inbound bytes, and our standing with the boards. 60 is a ceiling
# a real user cannot reach: the UI calls it once per pasted URL.
DAILY_FETCH_CAP=60
#
# NOTE for every numeric variable in this file: leave the line out, or comment it,
# to take the default. An EMPTY value is not "no limit" — it fails to parse as an
# integer and the app refuses to start. Use 0 to switch a cap off.
#
# Upload limits (PLAN 20.6/S3). /resume/upload and /tools/scan read the file into
# memory, and a free account costs nothing to make, so an unbounded read is a
# cheap way to exhaust an instance. A master CV renders to ~30 pages at the
# extreme, hence the generous page ceiling.
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50
# The DOCX twin of MAX_PDF_PAGES: MAX_UPLOAD_MB caps COMPRESSED bytes, and a
# .docx is a zip — measured 343:1, so 0.298 MB of upload is 102 MB of XML that
# python-docx expands in full. A real 30-page master expands to 1.0 MB and an
# image-heavy CV at the upload cap to 10.3 MB, so 32 is ~3x the worst real
# document. The code raises this to 3 * MAX_UPLOAD_MB if you set it lower, so
# it can never refuse a CV the upload cap admits. <= 0 disables it.
MAX_DOCX_UNCOMPRESSED_MB=32

# Accounts (Phase 29): email + password sign-in beside the invite codes, which
# keep working exactly as before.
# "open" lets anyone create an account; "closed" refuses new signups with
# 403 signup_closed while every existing account keeps working — the switch to
# flip if open signup starts costing too much, no code deploy needed.
SIGNUP_MODE=open
# A session slides forward on use (at most every 12 h) by SESSION_TTL_DAYS, but
# never past SESSION_MAX_DAYS after the sign-in that created it.
SESSION_TTL_DAYS=30
SESSION_MAX_DAYS=180
# scrypt work factor for password hashes (r=8, p=1). 131072 (2**17) costs about
# 0.3 s and 128 MB per hash. Stored inside each hash, so raising it later locks
# nobody out: accounts are re-hashed at the new value on their next login.
AUTH_SCRYPT_N=131072
# Minutes a verification code/link and a password-reset link stay valid.
VERIFY_TTL_MIN=60
RESET_TTL_MIN=60
# How verification and reset mail is delivered. "smtp" uses the ALERT_SMTP_*
# account above; if that is not configured, signup answers 503
# email_unavailable instead of pretending a code was sent. "console" prints each
# mail (code and link) to the server log instead — for local browser testing
# only. Never "console" in production: it writes live codes into the logs.
AUTH_EMAIL_MODE=smtp
# Secret for the HMACs that key the sign-in throttles (an IP address or an
# email is never stored in the clear). Optional: falls back to CRON_SECRET, then
# APP_ACCESS_CODE. Rotating whichever one is in use resets every throttle.
AUTH_SECRET=
# Google OAuth client (Google Cloud Console -> Credentials), used by the Gmail
# connect only. Sign-in never reads it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Continue with Google: the Web client of a SEPARATE Google Cloud project
# ("JobFinder Sign-in", In production, scopes openid, email and profile only),
# with the redirect URI APP_BASE_URL + /api/auth/google/callback. There is no
# fallback to the Gmail client above. The button shows once both are set and
# APP_BASE_URL is set.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# Gmail inbox scanner (Phase 29): reads employer replies and fills the tracker.
# Off until GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET + APP_BASE_URL + INBOX_TOKEN_KEY
# are all set. The Google client's redirect URI is APP_BASE_URL + /api/inbox/google/callback.
#
# Fernet key(s) encrypting stored Gmail refresh tokens, comma-separated, NEWEST
# FIRST (prepend a new key to rotate). Generate one with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Keep a copy: losing every key disconnects every Gmail user.
INBOX_TOKEN_KEY=
# The classifier's model, on its own client (never the tailor's). Empty = the
# default the classifier A/B picked (tests/inbox_eval.py).
INBOX_MODEL_ID=
# Model classifications per user per UTC day (admins exempt, <= 0 disables).
DAILY_INBOX_CAP=300
# Wall clock for one sync (the Sync button, and each user inside a cron tick) and
# for a whole cron tick, which must end under Vercel's 300 s limit.
INBOX_SYNC_BUDGET_S=25
INBOX_CRON_BUDGET_S=240
INBOX_MAX_MESSAGES_PER_RUN=150
# How far back the first import reads when the user does not pick.
INBOX_BACKFILL_DAYS=60
# Below this classifier confidence an email waits in Needs review.
INBOX_REVIEW_THRESHOLD=0.6
# "allowlist" = only admins and accounts enabled with PATCH /api/admin/users/<id>
# {"inbox_enabled": true} may connect (each must also be a Google test user while
# the app is in Testing); "all" = everyone.
INBOX_ACCESS=allowlist
# true while the Google app is in Testing: Google ends each Gmail grant after 7
# days, and the app says "reconnect by <date>" instead of failing silently.
GOOGLE_OAUTH_TESTING=true
# A canned demo mailbox so the Gmail flow works offline (local testing only —
# refused when APP_ACCESS_CODE is set and USE_STUB_LLM is false).
INBOX_FAKE_PROVIDER=false

# CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database url
DATABASE_URL=sqlite:///./jobfinder.db
