# OpenAI configuration
OPENAI_API_KEY=sk-your-key-here
# Set to your actual OpenAI model id once confirmed (e.g. gpt-4o, gpt-4.1, etc.)
MODEL_ID=gpt-4o

# Set to true to run the full pipeline offline with canned LLM responses
# (no API key needed). Useful for testing parsing/rendering/scoring/tracker.
USE_STUB_LLM=false

# CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database url
DATABASE_URL=sqlite:///./jobfinder.db
